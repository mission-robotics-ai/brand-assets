{
  "$schema": "mission-robotics brand tokens v2",
  "color": {
    "near-black": {
      "value": "#17181a",
      "role": "primary ground / ink"
    },
    "cream": {
      "value": "#e8e6dd",
      "role": "warm off-white ground / ink"
    },
    "white": {
      "value": "#ffffff",
      "role": "pure white ink"
    },
    "green": {
      "value": "#4ADE80",
      "role": "THE accent \u2014 matches newtheory-adjacent green, site canonical"
    }
  },
  "mark": {
    "grid": 7,
    "dot_size_base": 0.5,
    "dot_size_span": 0.42,
    "dot_size_formula": "s = 0.50 + 0.42*(1 - d);  d = dist_from_center / max_dist",
    "corner_radius_ratio": 0.29,
    "viewbox": "0 0 7 7"
  },
  "byline": {
    "text": "by New Theory",
    "color": {
      "value": "#6b7280",
      "role": "\"by New Theory\" byline \u2014 fixed across all inks, matches site gray-500"
    },
    "font": "Inter 400",
    "tracking_em": 0.025,
    "h_ratio": 0.5793,
    "gap_ratio": 0.4966,
    "x_ratio": 0.0276
  },
  "clearspace": {
    "rule": "half the mark height on all sides",
    "value": "0.5 * mark_height"
  },
  "min_size": {
    "mark_px": 24,
    "favicon_px": 16,
    "wordmark_one_line_px": 96,
    "lockup_px": 120
  }
}